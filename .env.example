# Escrow Sentinel environment. Every value is optional: CLI flags win over env vars,
# and the defaults below are the public production endpoints.
#
# No wallet, private key, seed phrase, API key or account is used by this project.
# The tool only performs public read-only HTTP and Solana RPC queries.

# Solana RPC endpoint used for getAccountInfo / getTokenAccountBalance.
# Any endpoint works; the public one is rate limited, so a dedicated endpoint
# (Helius / Triton / QuickNode ...) gives more stable results.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Public listing endpoint the Gibwork site itself calls.
GIB_EXPLORE_URL=https://api.gib.work/explore?page=1
# Public escrow/vault query the bounty page calls to render the escrow card.
GIB_VAULTS_URL=https://api.gib.work/vaults
# Bounty detail page template ({id} is replaced with the bounty id).
GIB_DETAIL_URL_TEMPLATE=https://gib.work/bounty/{id}

# auto   = live listing first, committed fixture as fallback (default)
# live   = fail instead of falling back
# fixture= replay the committed snapshot (no listing call)
ESCROW_SENTINEL_SOURCE=auto

# 1 = no network at all: replay the fixture and the verifications already stored
#     in the snapshot (no RPC client is created)
ESCROW_SENTINEL_OFFLINE=0
# 1 = fetch bounty detail pages for submission counts / gating fields
ESCROW_SENTINEL_ENRICH=1
# 1 = resolve escrow addresses through the public vault endpoint
ESCROW_SENTINEL_VAULT_LOOKUP=1
# Ranking depth for report/rank
ESCROW_SENTINEL_TOP=5
# Per-request timeout in milliseconds
ESCROW_SENTINEL_TIMEOUT_MS=15000
# 1 = never call an RPC endpoint (recorded evidence is replayed when available)
ESCROW_SENTINEL_RPC_DISABLED=0
# Override the project root (used by the test suite)
# ESCROW_SENTINEL_ROOT=.
